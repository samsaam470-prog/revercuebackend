{
  "name": "revercue-api",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "migrate:d1:local": "wrangler d1 migrations apply revercue-db --local",
    "migrate:d1:remote": "wrangler d1 migrations apply revercue-db --remote",
    "migrate:turso": "node scripts/turso-migrate.mjs",
    "migrate:turso:dry": "node scripts/turso-migrate.mjs --dry-run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "pdf-lib": "^1.17.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
